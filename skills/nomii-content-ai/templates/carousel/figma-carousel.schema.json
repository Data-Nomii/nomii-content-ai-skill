{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOMII Figma Carousel Handoff",
  "type": "object",
  "required": ["carousel", "slides"],
  "properties": {
    "carousel": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "buyer_persona": { "type": "string" },
        "kpi": { "type": "string" },
        "figma_file": { "type": "string", "default": "NOMII Carousel System" },
        "source_row_id": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "template", "role", "fields"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "template": { "type": "string" },
          "role": { "type": "string" },
          "text_zone": { "type": "string" },
          "face_safe_required": { "type": "boolean" },
          "image_focus": { "type": "string" },
          "selected_image_id": { "type": "string" },
          "selected_image_path": { "type": "string" },
          "image_selection_reason": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "notion_update": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "image_usage_increments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image_id": { "type": "string" },
              "increment_by": { "type": "integer", "default": 1 }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
